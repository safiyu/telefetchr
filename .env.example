# Telefetchr environment template.
#
# Copy this file to `.env` (same directory as docker-compose.yaml) and fill
# in your values:   cp .env.example .env
#
# .env is loaded automatically by docker compose and is git-ignored. NEVER
# commit real secrets.

# --- Required ---------------------------------------------------------------

# Admin password for the web UI. Must be strong and non-default, or the app
# refuses to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=change-me-generate-a-strong-password

# --- Optional ---------------------------------------------------------------

# Admin username (default: admin)
#ADMIN_USERNAME=admin

# JWT signing key. Leave unset to let the app generate one and persist it to
# the sessions volume (survives restarts). If you set it, use a long random
# value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#SECRET_KEY=

# Telegram API credentials from https://my.telegram.org
#API_ID=
#API_HASH=
#PHONE_NUMBER=

# Token lifetime in minutes (default: 1440 = 24h)
#ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated CIDRs allowed to bypass login (keep narrow, e.g. your /24)
#TRUSTED_SUBNETS=192.168.1.0/24

# Only the reverse proxy directly in front of the app (default: 127.0.0.1,::1)
#TRUSTED_PROXIES=172.18.0.1

# Extra CORS origins, comma-separated (default: empty = same-origin only)
#ALLOWED_ORIGINS=
